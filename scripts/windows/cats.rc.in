#include <windows.h>

IDI_CATS ICON "@ICON_PATH@"
1 RT_MANIFEST "@MANIFEST_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @FILE_VERSION@
 PRODUCTVERSION @FILE_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Rohan Allison\0"
      VALUE "FileDescription", "CATS Windows launcher\0"
      VALUE "FileVersion", "@PRODUCT_VERSION@\0"
      VALUE "InternalName", "Cats\0"
      VALUE "LegalCopyright", "Copyright (c) 2026 Rohan Allison\0"
      VALUE "OriginalFilename", "Cats.exe\0"
      VALUE "ProductName", "CATS\0"
      VALUE "ProductVersion", "@PRODUCT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
