# Build entry points are invoked across Windows and WSL. Keep POSIX scripts
# and Make recipes LF-only even when the checkout uses core.autocrlf.
*.sh text eol=lf
Makefile text eol=lf
*.go text eol=lf

# Windows PowerShell 5.1 accepts either form; CRLF is conventional and is what
# Authenticode signs in the assembled Windows archive.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
